POSTGRES_DB=codesazan
POSTGRES_USER=codesazan
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_DB_SECRET
AUTH_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_AUTH_SECRET
ADMIN_PASSWORD=
# Prefer ADMIN_PASSWORD_HASH generated by: node scripts/generate-admin-hash.js "your-password"
ADMIN_PASSWORD_HASH=
CORS_ORIGIN=http://localhost
STORAGE_PROVIDER=local
DB_POOL_MAX=20
EDGE_PORT=80
MEDIA_MAX_UPLOAD_BYTES=524288000
IMAGE_MAX_UPLOAD_BYTES=10485760
FILE_MAX_UPLOAD_BYTES=26214400


# v5.6.30: persistent host directories under ./data (not Docker-managed volumes).
DATA_ROOT=../codesazan-production-data
BOOTSTRAP_RETRIES=30

# Security / production
TRUST_PROXY=1
RATE_LIMIT=240
JSON_LIMIT=2mb
PAYMENT_PROVIDER=disabled

# Demo accounts are disabled automatically in production. Enable only in isolated test environments.
SEED_DEMO_USERS=false
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=35000
# Optional development-only demo accounts. Never enable in public production.
DEMO_PASSWORD=

# AES key used to encrypt SMS/email/payment provider credentials stored in PostgreSQL
INTEGRATION_CONFIG_KEY=replace-with-a-long-random-secret-at-least-32-chars
PUBLIC_BASE_URL=http://localhost
